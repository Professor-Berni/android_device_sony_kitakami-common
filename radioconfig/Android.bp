package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.radio.config@1.1-service.satsuki",
    owner: "lineage",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.radio.config@1.1-service.satsuki.rc"],
    vintf_fragments: ["android.hardware.radio.config@1.1-service.satsuki.xml"],
    srcs: [
        "RadioConfig.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.radio.config@1.0",
        "android.hardware.radio.config@1.1",
        "android.hardware.radio@1.0",
    ],
}
