cc_binary {
    name: "android.hardware.dumpstate-service.kitakami",
    vendor: true,
    relative_install_path: "hw",
    init_rc: [
        "android.hardware.dumpstate-service.kitakami.rc",
    ],
    vintf_fragments: [
        "android.hardware.dumpstate-service.kitakami.xml",
    ],
    srcs: ["main.cpp"],
    shared_libs: [
        "android.hardware.dumpstate-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-DLOG_TAG=\"android.hardware.dumpstate-service.kitakami\"",
    ],
}
