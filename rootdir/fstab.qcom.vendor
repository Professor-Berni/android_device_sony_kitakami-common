# Vendor-side fstab (second-stage init mounts + vold voldmanaged storage)

# Modem partition at /firmware (pil-q6v5-mss needs /firmware/image/modem.mdt; else modem never loads)
/dev/block/bootdevice/by-name/modem        /firmware       vfat ro,shortname=lower,uid=1000,gid=1000,dmask=222,fmask=222                     wait

# /data duplicated here (vold/late fs_mgr read /vendor/etc first); MUST match fstab.qcom byte-for-byte
/dev/block/bootdevice/by-name/userdata     /data           ext4 noatime,nosuid,nodev,barrier=1,noauto_da_alloc                               wait,check,length=-16384
/dev/block/bootdevice/by-name/cache        /cache          ext4 noatime,nosuid,nodev,barrier=1,noauto_da_alloc                               wait,check

# External SD: encryptable= intentionally omitted (modern vold adoptable-encryption via defaultkey)
/devices/soc.0/f98a4900.sdhci/mmc_host*    auto auto defaults    wait,voldmanaged=sdcard1:auto

# USB-OTG disk
/devices/soc.0/f9200000.ssusb/f9200000.dwc3/xhci-hcd.0.auto/usb* auto auto defaults    voldmanaged=usbdisk:auto
