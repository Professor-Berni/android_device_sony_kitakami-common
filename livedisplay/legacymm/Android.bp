cc_binary {
    name: "vendor.lineage.livedisplay-service.legacymm",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["vendor.lineage.livedisplay-service.legacymm.rc"],
    vintf_fragments: ["vendor.lineage.livedisplay-service.legacymm.xml"],
    srcs: [
        "DisplayModes.cpp",
        "PictureAdjustment.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libdl",
        "libutils",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
}
