package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.health-service.kitakami",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.health-service.kitakami.rc"],
    vintf_fragments: ["android.hardware.health-service.kitakami.xml"],
    overrides: ["charger"],

    defaults: [
        "libhealth_aidl_impl_user",
    ],
    static_libs: [
        "libhealth_aidl_impl",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],

    srcs: ["main.cpp"],
}
