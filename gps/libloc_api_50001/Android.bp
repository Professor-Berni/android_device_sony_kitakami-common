cc_library_shared {
    name: "libloc_eng",
    vendor: true,
    shared_libs: [
        "libutils",
        "libcutils",
        "libdl",
        "liblog",
        "libloc_core",
        "libgps.utils",
    ],
    srcs: [
        "loc_eng.cpp",
        "loc_eng_agps.cpp",
        "loc_eng_xtra.cpp",
        "loc_eng_ni.cpp",
        "loc_eng_log.cpp",
        "loc_eng_nmea.cpp",
        "LocEngAdapter.cpp",
    ] + [
        "loc_eng_dmn_conn.cpp",
        "loc_eng_dmn_conn_handler.cpp",
        "loc_eng_dmn_conn_thread_helper.c",
        "loc_eng_dmn_conn_glue_msg.c",
        "loc_eng_dmn_conn_glue_pipe.c",
    ],
    cflags: [
        "-fno-short-enums",
        "-D_ANDROID_",
    ],
    header_libs: [
        "libgps.utils_headers",
        "libloc_core_headers",
    ],
    include_dirs: [
        "hardware/libhardware/include",
    ],
}

cc_library_headers {
    name: "libloc_eng_headers",
    vendor: true,
    export_include_dirs: ["."],
}

cc_library_shared {
    name: "gps.msm8994",
    vendor: true,
    relative_install_path: "hw",
    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
        "libloc_eng",
        "libloc_core",
        "libgps.utils",
        "libdl",
    ],
    srcs: [
        "loc.cpp",
        "gps.c",
    ],
    cflags: [
        "-fno-short-enums",
        "-D_ANDROID_",
    ],
    header_libs: [
        "libgps.utils_headers",
        "libloc_core_headers",
    ],
    include_dirs: [
        "hardware/libhardware/include",
    ],
}
