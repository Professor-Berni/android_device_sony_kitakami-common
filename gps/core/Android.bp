cc_library_shared {
    name: "libloc_core",
    vendor: true,
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libgps.utils",
        "libdl",
    ],
    srcs: [
        "ContextBase.cpp",
        "LocAdapterBase.cpp",
        "LocApiBase.cpp",
        "loc_core_log.cpp",
        "LocDualContext.cpp",
    ],
    cflags: [
        "-fno-short-enums",
        "-D_ANDROID_",
    ],
    header_libs: [
        "libgps.utils_headers",
        "libloc_core_headers",
    ],
    include_dirs: [
        "hardware/libhardware/include",
    ],
}

cc_library_headers {
    name: "libloc_core_headers",
    vendor: true,
    export_include_dirs: ["."],
}
