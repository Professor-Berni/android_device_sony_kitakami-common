cc_library_shared {
    name: "libgps.utils",
    vendor: true,
    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
        "libprocessgroup",
    ],
    srcs: [
        "loc_log.cpp",
        "loc_cfg.cpp",
        "msg_q.c",
        "linked_list.c",
        "loc_target.cpp",
        "platform_lib_abstractions/elapsed_millis_since_boot.cpp",
        "LocHeap.cpp",
        "LocTimer.cpp",
        "LocThread.cpp",
        "MsgTask.cpp",
        "loc_misc_utils.cpp",
    ],
    cflags: [
        "-fno-short-enums",
        "-D_ANDROID_",
    ],
    local_include_dirs: [
        "platform_lib_abstractions",
    ],
    //# Includes
    ldflags: ["-Wl,--export-dynamic"],
    include_dirs: [
        "hardware/libhardware/include",
    ],
}

cc_library_headers {
    name: "libgps.utils_headers",
    vendor: true,
    export_include_dirs: [
        ".",
        "platform_lib_abstractions",
    ],
}
