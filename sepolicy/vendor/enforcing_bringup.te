# Allow rules for SELinux enforcing bring-up.

# audioserver
allow audioserver vendor_default_prop:file { getattr open read };

# bootanim
allow bootanim vendor_file:file { execute getattr open read };

# fsck
allow fsck block_device:blk_file { ioctl open read write };

# hal_audio_default
allow hal_audio_default audio_data_file:dir { search };
allow hal_audio_default audio_data_file:file { append getattr open read };
allow hal_audio_default audio_prop:file { getattr open read };
allow hal_audio_default default_prop:file { getattr open read };
allow hal_audio_default device:chr_file { ioctl open read write };
allow hal_audio_default sysfs:file { getattr open read };
allow hal_audio_default system_file:file { getattr open read };

# hal_camera_default
allow hal_camera_default camera_data_file:dir { search };
allow hal_camera_default default_prop:file { getattr open read };
allow hal_camera_default device:chr_file { ioctl open read write };
allow hal_camera_default init:unix_dgram_socket { sendto };
allow hal_camera_default radio_prop:file { getattr open read };
allow hal_camera_default sysfs:file { getattr open read };
allow hal_camera_default system_file:file { getattr open read };
allow hal_camera_default vndbinder_device:chr_file { ioctl open read write };

# hal_fingerprint_default
allow hal_fingerprint_default device:chr_file { ioctl open read write };

# hal_gatekeeper_default
allow hal_gatekeeper_default device:chr_file { ioctl open read write };
allow hal_gatekeeper_default system_prop:file { getattr open read };
allow hal_gatekeeper_default metadata_file:dir search;
allow hal_gatekeeper_default gatekeeper_metadata_file:dir rw_dir_perms;
allow hal_gatekeeper_default gatekeeper_metadata_file:file create_file_perms;

allow init gatekeeper_metadata_file:dir { create getattr setattr search relabelto };

# hal_graphics_allocator_default
allow hal_graphics_allocator_default default_prop:file { getattr open read };
allow hal_graphics_allocator_default sysfs:file { getattr open read };

# hal_graphics_composer_default
allow hal_graphics_composer_default bootanim_system_prop:file { getattr open read };
allow hal_graphics_composer_default default_prop:file { getattr open read };
allow hal_graphics_composer_default persist_display_file:dir { search };
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { bind create read setopt };
allow hal_graphics_composer_default sysfs:file { getattr open read };
allow hal_graphics_composer_default system_data_file:sock_file { write };
set_prop(hal_graphics_composer_default, system_prop)
allow hal_graphics_composer_default persist_file:dir search;
allow hal_graphics_composer_default vndbinder_device:chr_file { ioctl open read write };
allow hal_graphics_composer_default vndservicemanager:binder { call transfer };

# hal_keymaster_default
allow hal_keymaster_default device:chr_file { ioctl open read write };
allow hal_keymaster_default system_prop:file { getattr open read };

# hal_lineage_health_default
allow hal_lineage_health_default sysfs:file { getattr open read write };

# hwservicemanager
allow hwservicemanager vendor_file:file { getattr open read };

# ims
allow ims default_prop:file { getattr open read };
allow ims device:chr_file { ioctl open read write };
allow ims init:unix_stream_socket { connectto };
allow ims netmgrd:unix_stream_socket { connectto };
allow ims property_socket:sock_file { write };
allow ims self:netlink_socket { bind create read };
allow ims self:socket { bind create ioctl read };
allow ims self:udp_socket { create ioctl };
allow ims socket_device:dir { add_name write };
allow ims socket_device:sock_file { create write };
allow ims sysfs:dir { open read };
allow ims sysfs:file { getattr open read };
allow ims system_file:file { getattr open read };

# init
allow init adsprpcd_exec:file { execute execute_no_trans getattr open read };
allow init block_device:blk_file { write };
allow init debugfs_mmc:file { setattr };
allow init device:chr_file { ioctl open read write };
allow init functionfs:dir { mounton };
allow init hal_camera_default:fd { use };
allow init hwservice_contexts_file:file { getattr open read };
allow init irsc_util_exec:file { execute execute_no_trans getattr open read };
allow init kernel:security { setcheckreqprot };
allow init ppd:unix_stream_socket { connectto };
allow init proc:file { getattr open read };
allow init qmuxd:unix_stream_socket { connectto };
allow init ram_device:blk_file { write };
allow init same_process_hal_file:file { execute };
allow init self:capability2 { wake_alarm };
allow init self:netlink_kobject_uevent_socket { bind create getopt read setopt };
allow init self:socket { create ioctl };
allow init servicemanager:binder { transfer };
allow init socket_device:sock_file { write };
allow init sysfs_livedisplay_tuneable:file { setattr };
allow init system_data_file:file { append };
allow init system_data_file:sock_file { write };
allow init system_file:file { mounton };
allow init system_server:binder { transfer };
allow init tad:unix_stream_socket { connectto };
allow init tmp_root_mount_file:dir { mounton };
allow init vendor_file:file { execute getattr open read };
allow init video_device:chr_file { open read };
allow init vndservicemanager:binder { call transfer };

# init-power-sh
allow init-power-sh vendor_file:file { getattr open read };

# installd
allow installd vendor_file:file { getattr open read };

# kernel
allow kernel device:blk_file { create getattr setattr unlink };
allow kernel device:chr_file { create setattr };
allow kernel vendor_file:file { getattr open read };

# loc_launcher
allow loc_launcher init:unix_stream_socket { connectto };
allow loc_launcher loc_launcher_exec:file { execute_no_trans };
allow loc_launcher property_socket:sock_file { write };
allow loc_launcher self:capability2 { block_suspend };
allow loc_launcher self:socket { create ioctl read write };
allow loc_launcher self:udp_socket { ioctl };
allow loc_launcher socket_device:dir { add_name write };
allow loc_launcher socket_device:sock_file { create write };
allow loc_launcher sysfs:dir { open read };
allow loc_launcher sysfs:file { getattr open read };
allow loc_launcher system_data_file:dir { open read };
allow loc_launcher system_data_file:file { create getattr ioctl lock open read setattr unlink write };
allow loc_launcher system_data_file:sock_file { write };
allow loc_launcher wifi_hal_prop:file { getattr open read };

# logpersist
allow logpersist vendor_file:file { getattr open read };

# mediacodec
allow mediacodec default_prop:file { getattr open read };
allow mediacodec init:unix_stream_socket { connectto };
allow mediacodec system_data_file:sock_file { write };

# mediaswcodec
allow mediaswcodec vendor_file:file { execute getattr open read };

# netmgrd
allow netmgrd device:chr_file { ioctl open read write };
allow netmgrd netd:binder { call };
allow netmgrd netd_service:service_manager find;
allow netmgrd dnsresolver_service:service_manager find;
allow netmgrd mdns_service:service_manager find;
allow netmgrd proc_net:file { getattr open read write };
allow netmgrd qmuxd:unix_stream_socket { connectto };
allow netmgrd self:capability { net_admin net_raw setgid setpcap setuid sys_module };
allow netmgrd self:netlink_route_socket { bind create getattr nlmsg_read nlmsg_write read setopt write };
allow netmgrd self:netlink_socket { bind create read write };
allow netmgrd self:netlink_xfrm_socket { bind create };
allow netmgrd self:rawip_socket { create getopt setopt };
allow netmgrd self:socket { create ioctl read write };
allow netmgrd self:udp_socket { create ioctl };
allow netmgrd servicemanager:binder { call };
allow netmgrd socket_device:dir { add_name write };
allow netmgrd socket_device:sock_file { create setattr write };
allow netmgrd sysfs:dir { open read };
allow netmgrd sysfs:file { getattr open read };
allow netmgrd system_file:file { execute_no_trans lock };

# nfc
allow nfc nfc_device:chr_file { ioctl open read write };
allow nfc system_data_file:dir { add_name remove_name };
allow nfc system_data_file:file { create open rename unlink write };
allow nfc vendor_file:file { execute getattr open read };

# per_mgr
allow per_mgr servicemanager:binder { call transfer };
allow per_mgr sysfs:dir { open read };
allow per_mgr sysfs:file { open read };

# per_proxy
allow per_proxy sysfs:dir { open read };

# platform_app
allow platform_app vendor_file:file { execute getattr open read };

# ppd
allow ppd default_prop:file { getattr open read };
allow ppd device:chr_file { ioctl open read write };
allow ppd sysfs:file { getattr open read write };
allow ppd system_prop:file { getattr open read };

# priv_app
allow priv_app vendor_file:file { execute getattr open read };

# qmuxd
allow qmuxd device:chr_file { ioctl open read write };
allow qmuxd socket_device:dir { add_name remove_name write };
allow qmuxd socket_device:sock_file { create getattr setattr unlink };
allow qmuxd sysfs:dir { open read };
allow qmuxd sysfs:file { getattr open read write };
allow qmuxd sysfs_wake_lock:file { append open };

# radio
allow radio self:netlink_kobject_uevent_socket { bind create read setopt };
allow radio sysfs_switch:dir { search };

# rild
allow rild default_prop:file { getattr open read };
allow rild device:chr_file { ioctl open read write };
allow rild netmgrd:unix_stream_socket { connectto };
allow rild radio_core_data_file:dir { add_name getattr open read remove_name search write };
allow rild radio_core_data_file:file { create getattr ioctl lock open read setattr unlink write };
allow rild self:socket { ioctl };
allow rild socket_device:dir { add_name write };
allow rild socket_device:sock_file { create };
allow rild system_data_file:dir { getattr };
allow rild system_file:file { getattr open read };
allow rild vendor_file:file { lock };
allow rild vndbinder_device:chr_file { ioctl open read write };

# rmt_storage
allow rmt_storage block_device:blk_file { open read write };
allow rmt_storage block_device:dir { open read };
allow rmt_storage debugfs:file { open write };
allow rmt_storage self:capability { net_bind_service setgid setpcap setuid };
allow rmt_storage self:capability2 { block_suspend };
allow rmt_storage self:socket { bind create ioctl read write };
allow rmt_storage sysfs:dir { open read };
allow rmt_storage sysfs:file { getattr open read };
allow rmt_storage sysfs_wake_lock:file { append open };
allow rmt_storage uio_device:chr_file { open read write };

# secd
allow secd device:chr_file { ioctl open read write };

# secure_element
allow secure_element system_data_file:dir { add_name create remove_name };
allow secure_element system_data_file:file { create open rename unlink write };

# sensors
allow sensors device:chr_file { ioctl open read write };
allow sensors self:capability { chown dac_override net_raw setgid setuid };
allow sensors self:capability2 { block_suspend };
allow sensors self:socket { bind create ioctl read write };
allow sensors socket_device:dir { add_name write };
allow sensors socket_device:sock_file { create getattr setattr write };
allow sensors sysfs:dir { open read };
allow sensors sysfs:file { getattr };
allow sensors sysfs_wake_lock:file { append open };
allow sensors unlabeled:file { append getattr open read write };
allow sensors vendor_file:file { getattr open read };

# servicemanager
allow servicemanager vendor_file:file { getattr open read };

# surfaceflinger
allow surfaceflinger init:binder { call };
allow surfaceflinger vendor_default_prop:file { getattr open };
allow surfaceflinger vendor_file:file { execute getattr open read };

# system_app
allow system_app vendor_file:file { execute getattr open read };

# system_server
allow system_server debugfs_wakeup_sources:file { getattr open read };
allow system_server device:chr_file { getattr ioctl open read write };
allow system_server qmuxd:unix_stream_socket { connectto };
allow system_server self:socket { ioctl };
allow system_server socket_device:dir { add_name write };
allow system_server socket_device:sock_file { create };
allow system_server subsys_modem_device:chr_file { open read };
allow system_server sysfs:file { getattr open read };
allow system_server vendor_file:file { execute getattr open read };

# tad
allow tad trim_area_partition_device:blk_file { ioctl };

# timekeep
allow timekeep vendor_data_file:file { getattr open write };

# toolbox
allow toolbox media_rw_data_file:dir { getattr };
allow toolbox ram_device:blk_file { getattr ioctl open read write };
allow toolbox tmp_root_mount_file:dir { getattr open read remove_name rmdir search write };

# ueventd
allow ueventd proc:file { getattr open read };

# untrusted_app_27
allow untrusted_app_27 vendor_file:file { execute getattr open read };

# vendor_init
allow vendor_init default_prop:property_service { set };
allow vendor_init radio_prop:property_service { set };

# vold
allow vold unlabeled:dir { mounton };
allow vold vendor_file:file { getattr open read };

# vold_prepare_subdirs
allow vold_prepare_subdirs vendor_file:file { getattr open read };

# zygote
allow zygote vendor_file:file { getattr open read };

allow init { domain -lmkd -llkd -crash_dump }:process { noatsecure };
allow init debugfs_tracing_debug:dir { write };

# system_server
allow system_server debugfs:file { getattr open read };
allow system_server socket_device:dir { remove_name };
allow system_server socket_device:sock_file { unlink };

# hal_graphics_composer_default
allow hal_graphics_composer_default default_android_vndservice:service_manager { add };
allow hal_graphics_composer_default hal_graphics_allocator_service:service_manager { find };

# hal_power_default
allow hal_power_default system_data_file:sock_file { write };

# hal_lineage_livedisplay_sysfs
allow hal_lineage_livedisplay_sysfs ppd:unix_stream_socket { connectto };
allow hal_lineage_livedisplay_sysfs socket_device:sock_file { write };

# vold
allow vold vold_prepare_subdirs:process { noatsecure };

# nfc
allow nfc system_data_file:dir { write };

# kernel
allow kernel self:capability { mknod };

# webview_zygote
allow webview_zygote mnt_expand_file:dir { getattr };

# sensors
allow sensors persist_file:dir search;
allow sensors sensors_persist_file:dir create_dir_perms;
allow sensors sensors_persist_file:file create_file_perms;

# audio HAL
allow hal_audio_default hal_power_service:service_manager find;
allow hal_audio_default hal_power_hwservice:hwservice_manager find;
allow hal_audio_default system_data_file:sock_file write;

# rild / loc_launcher
allow rild socket_device:dir remove_name;
allow rild socket_device:sock_file unlink;
allow loc_launcher socket_device:dir remove_name;
allow loc_launcher socket_device:sock_file unlink;

# netmgrd
set_prop(netmgrd, vendor_net_radio_prop)
set_prop(netmgrd, net_radio_prop)

allowxperm netmgrd self:udp_socket ioctl { 0x8900-0x89ff };

# rmt_storage
allow rmt_storage block_device:dir search;
allow rmt_storage self:capability sys_admin;

dontaudit appdomain vendor_file:file { read getattr open };

