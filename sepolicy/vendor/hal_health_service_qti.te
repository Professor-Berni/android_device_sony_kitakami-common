type hal_health_service_qti, domain;
type hal_health_service_qti_exec, exec_type, file_type;

# Started by init
init_daemon_domain(hal_health_service_qti)

allow hal_health_service_qti hal_health_service:service_manager add;
allow hal_health_service_qti kmsg_device:chr_file rw_file_perms;
allow hal_health_service_qti self:capability2 { block_suspend wake_alarm };
allow hal_health_service_qti self:netlink_kobject_uevent_socket create_socket_perms;
allow hal_health_service_qti servicemanager:binder { call transfer };
allow hal_health_service_qti sysfs:dir r_dir_perms;
allow hal_health_service_qti sysfs:file r_file_perms;
allow hal_health_service_qti sysfs_battery_supply:dir r_dir_perms;
allow hal_health_service_qti sysfs_battery_supply:file r_file_perms;
allow hal_health_service_qti system_server:binder call;
allow hal_health_service_qti unlabeled:binder impersonate;
