# Legacy QCOM/Sony init services.

# adsprpcd 
type adsprpcd, domain;
init_daemon_domain(adsprpcd)
allow adsprpcd qdsp_device:chr_file rw_file_perms;
allow adsprpcd ion_device:chr_file rw_file_perms;

# irsc_util 
type irsc_util, domain;
init_daemon_domain(irsc_util)
allow irsc_util self:socket { create ioctl };
allow irsc_util system_file:file r_file_perms;

# thermal-engine 
type thermal_engine_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(thermal_engine)
allow thermal_engine self:capability dac_override;
allow thermal_engine self:socket { create read write ioctl };
allow thermal_engine qmuxd:unix_stream_socket connectto;
allow thermal_engine socket_device:dir { search add_name remove_name write };
allow thermal_engine socket_device:sock_file { create write unlink };
allow thermal_engine thermal_device:chr_file rw_file_perms;
allow thermal_engine sysfs:dir r_dir_perms;
allow thermal_engine sysfs:file rw_file_perms;
allow thermal_engine sysfs_devices_system_cpu:file rw_file_perms;
allow thermal_engine system_file:file r_file_perms;
get_prop(thermal_engine, system_prop)
dontaudit thermal_engine default_prop:file { getattr open read };

# macaddrsetup
type macaddrsetup, domain;
type macaddrsetup_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(macaddrsetup)
allow macaddrsetup tad:unix_stream_socket connectto;
allow macaddrsetup tad_socket:sock_file write;
allow macaddrsetup vendor_data_file:dir { search add_name };
allow macaddrsetup vendor_data_file:file create_file_perms;

# imscmservice 
type imscmservice, domain;
type imscmservice_exec, exec_type, file_type, vendor_file_type;
type imscm_service, vndservice_manager_type;
init_daemon_domain(imscmservice)
vndbinder_use(imscmservice)
allow imscmservice imscm_service:service_manager add;
allow imscmservice sysfs:dir r_dir_perms;
allow imscmservice sysfs:file r_file_perms;
