# Started by init
init_daemon_domain(ims)

allow ims default_prop:file r_file_perms;
allow ims device:chr_file rw_file_perms;
allow ims hal_imsrtp_hwservice:hwservice_manager { add find };
allow ims hidl_base_hwservice:hwservice_manager { add find };
allow ims init:unix_stream_socket { connectto };
allow ims ion_device:chr_file rw_file_perms;
allow ims netmgrd:unix_stream_socket { connectto };
allow ims property_socket:sock_file rw_file_perms;
allow ims qmuxd:unix_stream_socket connectto;
allow ims self:netlink_socket create_socket_perms;
allow ims self:socket create_socket_perms;
allow ims self:udp_socket create_socket_perms;
allow ims socket_device:dir rw_dir_perms;
allow ims socket_device:sock_file create_file_perms;
allow ims sysfs:dir r_dir_perms;
allow ims sysfs:file r_file_perms;
allow ims system_file:file r_file_perms;
allow ims system_prop:property_service set;
allowxperm ims self:udp_socket ioctl { 0x8900-0x89ff };
set_prop(ims, vendor_ims_prop)
