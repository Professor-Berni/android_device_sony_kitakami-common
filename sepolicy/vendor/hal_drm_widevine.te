type hal_drm_widevine, domain;
type hal_drm_widevine_exec, exec_type, vendor_file_type, file_type;

# Started by init -> transition into the hal_drm_widevine domain
init_daemon_domain(hal_drm_widevine)

# hal_drm_server: lets app clients binder_call this service + inherits base hal_drm rules
hal_server_domain(hal_drm_widevine, hal_drm)

allow hal_drm_widevine hal_drm_hwservice:hwservice_manager { add find };
allow hal_drm_widevine hidl_base_hwservice:hwservice_manager add;
allow hal_drm_widevine hwservicemanager:binder { call transfer };
allow hal_drm_widevine hwservicemanager_prop:file r_file_perms;
allow hal_drm_widevine mediadrmserver:binder { call transfer };

allow hal_drm_widevine mediadrm_vendor_data_file:dir create_dir_perms;
allow hal_drm_widevine mediadrm_vendor_data_file:file create_file_perms;

allow hal_drm_widevine media_data_file:lnk_file read;
