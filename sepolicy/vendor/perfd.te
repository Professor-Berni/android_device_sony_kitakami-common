# perfd service
type perfd, domain;
init_daemon_domain(perfd)

allow perfd sysfs_memory:dir search;
allow perfd sysfs_memory:file { open read write };

allow perfd sysfs_devices_system_cpu:dir { search read open };
allow perfd sysfs_devices_system_cpu:file rw_file_perms;
allow perfd sysfs_devices_system_cpu:lnk_file read;

allow perfd sysfs_cpu_boost:dir search;
allow perfd sysfs_cpu_boost:file rw_file_perms;

allow perfd sysfs_msm_perf:dir search;
allow perfd sysfs_msm_perf:file rw_file_perms;

allow perfd sysfs_performance:dir r_dir_perms;
allow perfd sysfs_performance:file rw_file_perms;
allow perfd sysfs_kgsl:dir search;
allow perfd sysfs_kgsl:file rw_file_perms;

allow perfd proc_kernel_sched:file rw_file_perms;

allow perfd sysfs:dir { search read open };
allow perfd sysfs:file rw_file_perms;

allow perfd system_data_file:dir { search write add_name remove_name create rw_dir_perms };
allow perfd system_data_file:file create_file_perms;
allow perfd system_data_file:sock_file create_file_perms;

allow perfd self:unix_stream_socket { create_socket_perms_no_ioctl listen accept };
