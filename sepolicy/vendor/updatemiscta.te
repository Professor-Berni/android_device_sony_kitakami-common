# updatemiscta service
type updatemiscta, domain, coredomain;
type updatemiscta_exec, exec_type, file_type, system_file_type;

# Started by init
init_daemon_domain(updatemiscta)

unix_socket_connect(taimport, tad, tad)

allow updatemiscta default_prop:property_service set;
allow updatemiscta init:unix_stream_socket connectto;
allow updatemiscta property_socket:sock_file rw_file_perms;
allow updatemiscta socket_device:sock_file rw_file_perms;
allow updatemiscta tad_socket:sock_file rw_file_perms;
allow updatemiscta tad:unix_stream_socket connectto;
allow updatemiscta vendor_ta_prop:file r_file_perms;
