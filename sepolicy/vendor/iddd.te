# iddd service
type iddd, domain, coredomain;
type iddd_exec, exec_type, file_type, system_file_type;

# Started by init
init_daemon_domain(iddd)

allow iddd diag_data_file:dir create_dir_perms;
allow iddd diag_data_file:file create_file_perms;
allow iddd diag_data_file:sock_file create_file_perms;
allow iddd firmware_file:dir r_dir_perms;
allow iddd socket_device:sock_file rw_file_perms;
allow iddd tad_socket:sock_file rw_file_perms;
allow iddd tad:unix_stream_socket connectto;
