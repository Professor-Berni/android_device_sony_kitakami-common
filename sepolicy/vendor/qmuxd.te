# QMI multiplexer daemon types for legacy Qualcomm radio
type qmuxd, domain, coredomain;
type qmuxd_exec, exec_type, file_type, system_file_type;
type qmuxd_socket, file_type;

# Started by init -> transition into the qmuxd domain
init_daemon_domain(qmuxd)

allow qmuxd device:chr_file rw_file_perms;
allow qmuxd socket_device:dir w_dir_perms;
allow qmuxd socket_device:sock_file create_file_perms;
allow qmuxd sysfs:dir r_dir_perms;
allow qmuxd sysfs:file rw_file_perms;
allow qmuxd sysfs_wake_lock:file ra_file_perms;
